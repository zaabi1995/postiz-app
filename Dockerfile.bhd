# BHD fork build.
# Uses the official Postiz image as the base (already has node_modules,
# nginx config, pm2 setup), but replaces ALL source code with our fork's
# version so version mismatches between upstream master and the ghcr.io
# image don't cause cross-imports to break.
#
# Build:
#   docker build -f Dockerfile.bhd -t bhd-postiz:latest .

FROM ghcr.io/gitroomhq/postiz-app:latest

WORKDIR /app

# Replace the entire source tree with our fork's version. This is heavier
# than copying just the changed files but eliminates the class of bugs
# where our edits reference files that exist in our fork but not in the
# upstream base image.
COPY apps/backend/src/   /app/apps/backend/src/
COPY apps/frontend/src/  /app/apps/frontend/src/
COPY apps/orchestrator/src/ /app/apps/orchestrator/src/
COPY libraries/         /app/libraries/

# Workspace metadata that may have drifted
COPY apps/backend/package.json   /app/apps/backend/package.json
COPY apps/frontend/package.json  /app/apps/frontend/package.json
COPY apps/orchestrator/package.json /app/apps/orchestrator/package.json
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json /app/

# Reinstall deps (official image is production-pruned) and rebuild
RUN pnpm install --prefer-offline --no-frozen-lockfile && \
    pnpm run build:frontend && \
    pnpm run build:backend
